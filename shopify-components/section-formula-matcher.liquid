{% comment %}
  ALLFEAMS™ - Interactive Formula Matcher Section
  File: sections/section-formula-matcher.liquid
  
  Paste this file into Shopify Admin -> Online Store -> Themes -> Edit Code -> Sections -> Add new section.
{% endcomment %}

<section class="formula-matcher-section py-16 lg:py-24 bg-white border-y border-sand-300/70" id="formula-finder">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs uppercase tracking-widest text-gold-600 font-semibold block mb-2">{{ section.settings.subheading }}</span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-noir-900">{{ section.settings.heading }}</h2>
      <p class="text-sm sm:text-base text-noir-600 mt-3 font-light">{{ section.settings.description }}</p>
    </div>

    <!-- Concern Pills -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 max-w-4xl mx-auto mb-10">
      <button type="button" onclick="switchFormula('flora')" id="tab-flora" class="formula-tab p-4 rounded-2xl border-2 border-noir-900 bg-sand-100 text-noir-900 text-left transition-all shadow-sm">
        <span class="text-2xl mb-2 block">🌸</span>
        <h4 class="font-semibold text-xs sm:text-sm">Vaginal Freshness &amp; pH</h4>
        <p class="text-[11px] text-noir-600 mt-1">Odor, discharge, and microbiome balance</p>
      </button>

      <button type="button" onclick="switchFormula('harmony')" id="tab-harmony" class="formula-tab p-4 rounded-2xl border border-sand-300 bg-white text-noir-800 text-left hover:border-gold-500 transition-all">
        <span class="text-2xl mb-2 block">⚖️</span>
        <h4 class="font-semibold text-xs sm:text-sm">Cycle &amp; Ovarian Balance</h4>
        <p class="text-[11px] text-noir-600 mt-1">Hormonal cramps, mood &amp; regularity</p>
      </button>

      <button type="button" onclick="switchFormula('flatfemme')" id="tab-flatfemme" class="formula-tab p-4 rounded-2xl border border-sand-300 bg-white text-noir-800 text-left hover:border-gold-500 transition-all">
        <span class="text-2xl mb-2 block">🌿</span>
        <h4 class="font-semibold text-xs sm:text-sm">Bloating &amp; Gut Ease</h4>
        <p class="text-[11px] text-noir-600 mt-1">Digestive inflammation, gas &amp; cravings</p>
      </button>

      <button type="button" onclick="switchFormula('moisture')" id="tab-moisture" class="formula-tab p-4 rounded-2xl border border-sand-300 bg-white text-noir-800 text-left hover:border-gold-500 transition-all">
        <span class="text-2xl mb-2 block">💧</span>
        <h4 class="font-semibold text-xs sm:text-sm">Moisture &amp; Menopause</h4>
        <p class="text-[11px] text-noir-600 mt-1">Intimate dryness, hot flashes &amp; comfort</p>
      </button>
    </div>

    <!-- Match Result Card Container -->
    <div id="formula-result-card" class="bg-sand-100 rounded-3xl p-6 sm:p-10 border border-sand-300 shadow-xl transition-all duration-500">
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Formula Matcher",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Personalized Recommendation"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Exact Formula in 1 Click"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Select your primary balance objective to match with our clinically backed bioactive formulation:"
    }
  ],
  "presets": [
    {
      "name": "Formula Matcher"
    }
  ]
}
{% endschema %}
