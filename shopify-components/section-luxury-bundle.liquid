{% comment %}
  ALLFEAMS™ - 3-Tier Luxury Bundle Section
  File: sections/section-luxury-bundle.liquid
{% endcomment %}

<section class="luxury-bundle-section py-16 lg:py-24 bg-noir-900 text-sand-100 relative overflow-hidden" id="bundle-offers">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-10">
      <span class="text-xs uppercase tracking-widest text-gold-500 font-semibold block mb-2">{{ section.settings.subheading }}</span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-white">{{ section.settings.heading }}</h2>
      <p class="text-sm sm:text-base text-sand-300 mt-3 font-light">{{ section.settings.description }}</p>

      <!-- Formula preference buttons -->
      <div class="mt-6 inline-flex items-center bg-noir-800 p-1.5 rounded-full border border-noir-700">
        <span class="text-xs text-sand-400 px-3">Choose Formula:</span>
        <button type="button" onclick="setBundleFormula('flora')" id="b-form-flora" class="bundle-formula-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-gold-500 text-noir-900 transition">Flora+</button>
        <button type="button" onclick="setBundleFormula('harmony')" id="b-form-harmony" class="bundle-formula-btn px-4 py-1.5 rounded-full text-xs font-semibold text-sand-300 hover:text-white transition">Harmony+</button>
        <button type="button" onclick="setBundleFormula('flatfemme')" id="b-form-flatfemme" class="bundle-formula-btn px-4 py-1.5 rounded-full text-xs font-semibold text-sand-300 hover:text-white transition">FlatFeams</button>
      </div>
    </div>

    <!-- 3 Tier Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
      
      <!-- Tier 1 -->
      <div class="bg-noir-800 rounded-3xl p-6 lg:p-8 border border-noir-700 flex flex-col justify-between hover:border-gold-600/50 transition">
        <div>
          <span class="text-xs uppercase tracking-wider text-sand-400 font-medium">Starter Experience</span>
          <h3 class="font-serif text-3xl text-white mt-1">1 Bottle</h3>
          <p class="text-xs text-sand-300 mt-1">30-Day Individual Reset</p>
          <div class="my-6">
            <span class="text-4xl font-bold text-white price-display" data-usd="34.95">$34.95</span>
            <span class="text-xs text-sand-400 ml-1">/ bottle</span>
          </div>
          <ul class="space-y-3 text-xs text-sand-200 border-t border-noir-700 pt-6">
            <li>✓ Full 30-day supply</li>
            <li>✓ Hormone-free &amp; vegan</li>
            <li>✓ 60-Day money-back guarantee</li>
          </ul>
        </div>
        <button type="button" onclick="addBundleToCart(1)" class="mt-8 w-full py-3.5 bg-noir-700 hover:bg-gold-600 hover:text-noir-900 text-sand-100 rounded-xl text-xs uppercase tracking-widest font-semibold transition">
          Select 1 Bottle
        </button>
      </div>

      <!-- Tier 2 (Highlighted) -->
      <div class="bg-gradient-to-b from-noir-800 to-noir-800/90 rounded-3xl p-6 lg:p-8 border-2 border-gold-500 relative shadow-2xl flex flex-col justify-between transform md:-translate-y-3">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-gold-500 text-noir-900 text-[10px] uppercase font-bold tracking-widest px-4 py-1 rounded-full shadow-md">
          Most Popular &bull; 90-Day Reset
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider text-gold-500 font-semibold">Recommended by 92% of Doctors</span>
          <h3 class="font-serif text-3xl text-white mt-1">3 Bottles (Save 38%)</h3>
          <p class="text-xs text-sand-300 mt-1">Complete Microbiome &amp; Odor Equilibrium</p>
          <div class="my-6">
            <div class="flex items-baseline gap-2">
              <span class="text-4xl font-bold text-white price-display" data-usd="24.95">$24.95</span>
              <span class="text-xs text-sand-400">/ bottle</span>
              <span class="text-xs line-through text-sand-400 original-price-display" data-usd="34.95">$34.95</span>
            </div>
            <p class="text-xs text-gold-400 font-medium mt-1">Total: <span class="price-display" data-usd="74.85">$74.85</span> &bull; Free Discreet Shipping</p>
          </div>
          <ul class="space-y-3 text-xs text-sand-100 border-t border-noir-700 pt-6">
            <li>✓ <strong>Save $30.00 instantly</strong></li>
            <li>✓ Free Plain Unbranded Box Shipping</li>
            <li>✓ Free "The Inside-Out Guide" (PDF)</li>
            <li>✓ 60-Day Empty-Bottle Guarantee</li>
          </ul>
        </div>
        <button type="button" onclick="addBundleToCart(3)" class="btn-gold-shimmer mt-8 w-full py-4 bg-gold-500 hover:bg-gold-400 text-noir-900 rounded-xl text-xs uppercase tracking-widest font-bold shadow-lg transition">
          Claim 3-Bottle Bundle &bull; Save 38%
        </button>
      </div>

      <!-- Tier 3 -->
      <div class="bg-noir-800 rounded-3xl p-6 lg:p-8 border border-noir-700 flex flex-col justify-between hover:border-gold-600/50 transition">
        <div>
          <span class="text-xs uppercase tracking-wider text-sand-400 font-medium">Ultimate Longevity</span>
          <h3 class="font-serif text-3xl text-white mt-1">6 Bottles (Save 48%)</h3>
          <p class="text-xs text-sand-300 mt-1">180-Day Systemic Total Balance</p>
          <div class="my-6">
            <div class="flex items-baseline gap-2">
              <span class="text-4xl font-bold text-white price-display" data-usd="21.95">$21.95</span>
              <span class="text-xs text-sand-400">/ bottle</span>
              <span class="text-xs line-through text-sand-400 original-price-display" data-usd="34.95">$34.95</span>
            </div>
            <p class="text-xs text-gold-400 font-medium mt-1">Total: <span class="price-display" data-usd="131.70">$131.70</span> &bull; Free VIP Delivery</p>
          </div>
          <ul class="space-y-3 text-xs text-sand-200 border-t border-noir-700 pt-6">
            <li>✓ <strong>Maximum discount ($78 savings)</strong></li>
            <li>✓ Free Luxury Travel Pill Pouch</li>
            <li>✓ Free Priority Discreet Shipping</li>
            <li>✓ 60-Day Empty Bottle Guarantee</li>
          </ul>
        </div>
        <button type="button" onclick="addBundleToCart(6)" class="mt-8 w-full py-3.5 bg-noir-700 hover:bg-gold-600 hover:text-noir-900 text-sand-100 rounded-xl text-xs uppercase tracking-widest font-semibold transition">
          Select 6 Bottles
        </button>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Luxury Bundles",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated Transformation Rituals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Commit To Lasting Balance & Save"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Select the bundle that aligns with your wellness timeline:"
    }
  ],
  "presets": [
    {
      "name": "Luxury Bundles"
    }
  ]
}
{% endschema %}
