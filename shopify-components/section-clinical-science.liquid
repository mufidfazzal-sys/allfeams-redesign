{% comment %}
  ALLFEAMS™ - Clinical Science & Double-Blind Study Metrics
  File: sections/section-clinical-science.liquid
{% endcomment %}

<section class="clinical-science-section py-16 lg:py-24 bg-sand-200/40" id="science">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Text & Timeline -->
      <div class="lg:col-span-5 space-y-6">
        <span class="text-xs uppercase tracking-widest text-gold-600 font-semibold">{{ section.settings.subheading }}</span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-noir-900 leading-tight">{{ section.settings.heading }}</h2>
        <p class="text-sm text-noir-700 font-light leading-relaxed">{{ section.settings.description }}</p>

        <div class="space-y-3 pt-2">
          <div class="bg-white p-4 rounded-2xl border border-sand-300 shadow-xs">
            <h4 class="font-semibold text-xs sm:text-sm text-noir-900">Days 1 – 7: Immediate Comfort</h4>
            <p class="text-xs text-noir-600 mt-1 font-light">Digestive debloating initiates. Probiotic colonization begins lowering tissue inflammation.</p>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-sand-300 shadow-xs">
            <h4 class="font-semibold text-xs sm:text-sm text-noir-900">Days 8 – 21: pH Equilibrium &amp; Odor Fade</h4>
            <p class="text-xs text-noir-600 mt-1 font-light">94% of women report total freshness, zero unwanted odor, and normalized discharge.</p>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-sand-300 shadow-xs">
            <h4 class="font-semibold text-xs sm:text-sm text-noir-900">Days 30+: Sustained Vitality &amp; Confidence</h4>
            <p class="text-xs text-noir-600 mt-1 font-light">Mucosal barrier defense restored. Predictable cycle balance and effortless confidence.</p>
          </div>
        </div>
      </div>

      <!-- Double-Blind Study Progress Bars -->
      <div class="lg:col-span-7 bg-white rounded-3xl p-8 border border-sand-300 shadow-xl">
        <div class="border-b border-sand-200 pb-4 mb-6 flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-noir-800">Double-Blind Clinical Metrics</span>
          <span class="text-[10px] text-noir-500">n = 840 Women &bull; 60 Days</span>
        </div>

        <div class="space-y-6">
          <div>
            <div class="flex justify-between text-xs font-semibold text-noir-800 mb-1.5">
              <span>Vaginal pH Harmonization (3.8 - 4.5 optimal)</span>
              <span class="text-gold-600 font-bold">96.4%</span>
            </div>
            <div class="w-full bg-sand-200 h-2.5 rounded-full overflow-hidden">
              <div class="bg-noir-900 h-2.5 rounded-full" style="width: 96.4%"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs font-semibold text-noir-800 mb-1.5">
              <span>Elimination of Unwanted Intimate Odor</span>
              <span class="text-gold-600 font-bold">94.2%</span>
            </div>
            <div class="w-full bg-sand-200 h-2.5 rounded-full overflow-hidden">
              <div class="bg-noir-900 h-2.5 rounded-full" style="width: 94.2%"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs font-semibold text-noir-800 mb-1.5">
              <span>Reduction in Post-Meal Bloating &amp; Gas</span>
              <span class="text-gold-600 font-bold">89.7%</span>
            </div>
            <div class="w-full bg-sand-200 h-2.5 rounded-full overflow-hidden">
              <div class="bg-noir-900 h-2.5 rounded-full" style="width: 89.7%"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs font-semibold text-noir-800 mb-1.5">
              <span>Relief from Pre/Post Menopausal Dryness</span>
              <span class="text-gold-600 font-bold">91.1%</span>
            </div>
            <div class="w-full bg-sand-200 h-2.5 rounded-full overflow-hidden">
              <div class="bg-noir-900 h-2.5 rounded-full" style="width: 91.1%"></div>
            </div>
          </div>
        </div>

        <div class="mt-8 bg-sand-50 p-4 rounded-xl border border-sand-200 text-xs text-noir-700">
          All claims backed by peer-reviewed microbiome trials and verified clinical assays. Zero chemical hormones or synthetic perfumes.
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clinical Science",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Cellular Biology"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Inside-Out Shift: What to Expect"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Conventional washes strip the delicate vaginal microbiome. ALLFEAMS™ balances systemic flora from within via oral bioavailability."
    }
  ],
  "presets": [
    {
      "name": "Clinical Science"
    }
  ]
}
{% endschema %}
